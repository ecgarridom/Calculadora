<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/meitat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20" />

    <TextView
        android:id="@+id/txtPantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:gravity="end|center_vertical"
        android:hint="0"
        android:inputType="numberDecimal|numberSigned"
        android:padding="15dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:textSize="60dp"
        app:layout_constraintBottom_toTopOf="@id/meitat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75"/>


    <TableLayout
        android:id="@+id/miTabla"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/meitat">


        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnMMin"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnMMin"
                android:textColor="@color/orange"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnMMax"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnMMax"
                android:textColor="@color/orange"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnMr"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnMr"
                android:textColor="@color/orange"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnMc"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnMc"
                android:textColor="@color/orange"
                android:textSize="10pt" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn7"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn7"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn8"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn9"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnMult"
                android:textColor="@color/orange"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnMultiplica"
                android:textSize="10pt" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn4"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn4"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn5"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn6"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnDivideix"
                android:textColor="@color/orange"
                android:textSize="10pt" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn1"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn1"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn2"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn3"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnResta"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:layout_span="2"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnResta"
                android:textColor="@color/orange"
                android:textSize="10pt" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btn0"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:layout_span="2"
                android:backgroundTint="@color/darkblue"
                android:text="@string/Btn0"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnDecimal"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnDecimal"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnSuma"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:layout_span="1"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnSuma"
                android:textColor="@color/orange"
                android:textSize="10pt" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnIgual"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:layout_span="3"
                android:backgroundTint="@color/orange"
                android:text="@string/BtnIgual"
                android:textSize="10pt" />

            <Button
                android:id="@+id/btnC"
                android:layout_width="155dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="5dp"
                android:layout_span="1"
                android:backgroundTint="@color/darkblue"
                android:text="@string/BtnC"
                android:textColor="@color/red"
                android:textSize="10pt" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>